@import "./buttons.wxss";

/* 登录 / 注册 / 完善账号 */
.container--auth {
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.auth-hero {
  text-align: center;
  padding: 16rpx 16rpx 40rpx;
}

.auth-logo {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  box-shadow: 0 16rpx 40rpx rgba(21, 101, 192, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-logo-text {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.auth-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.auth-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  padding: 0 24rpx;
}

.auth-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 44rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.08);
  box-shadow: var(--shadow-card);
}

.form-error {
  font-size: 26rpx;
  color: var(--color-error);
  margin-bottom: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(198, 40, 40, 0.06);
  border: 1rpx solid rgba(198, 40, 40, 0.12);
  line-height: 1.45;
}

.form-field {
  margin-bottom: 28rpx;
}

.form-field:last-of-type {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 14rpx;
}

.input-box {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 96rpx;
  background: #f5f8fd;
  border-radius: 20rpx;
  border: 2rpx solid #e4ebf6;
  box-sizing: border-box;
  transition: border-color 0.2s;
}

.input-box:focus-within {
  border-color: var(--color-primary-light);
  background: #fff;
  box-shadow: 0 0 0 4rpx rgba(66, 165, 245, 0.12);
}

.input-box--password {
  padding-right: 120rpx;
}

.form-input-inner {
  flex: 1;
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  font-size: 30rpx;
  color: var(--color-text);
  box-sizing: border-box;
}

.pwd-toggle {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  min-width: 96rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
  border-radius: 14rpx;
}

.pwd-toggle--active {
  background: rgba(21, 101, 192, 0.08);
}

.form-actions {
  margin-top: 36rpx;
}

.split-line {
  position: relative;
  text-align: center;
  margin: 32rpx 0 24rpx;
}

.split-line::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  border-top: 1rpx solid var(--color-border);
}

.split-line text {
  position: relative;
  padding: 0 24rpx;
  background: #fff;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.auth-footer {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 28rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.auth-link {
  color: var(--color-primary);
  margin-left: 8rpx;
  font-weight: 700;
}

.register-line {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 28rpx;
  color: var(--color-text-secondary);
  font-size: 26rpx;
}

.register-link {
  color: var(--color-primary);
  margin-left: 8rpx;
  font-weight: 700;
}

/* account-complete 兼容旧 class 名 */
.login-header {
  text-align: center;
  padding: 16rpx 16rpx 40rpx;
}

.login-dot {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  margin: 0 auto 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(21, 101, 192, 0.3);
}

.login-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  padding: 0 24rpx;
}

.card--form {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 44rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.08);
  box-shadow: var(--shadow-card);
}

.mode-switch {
  display: flex;
  background: #eef3fa;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  color: var(--color-text-muted);
  font-size: 26rpx;
  border-radius: 14rpx;
}

.mode-btn--active {
  background: #fff;
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(21, 101, 192, 0.1);
}
