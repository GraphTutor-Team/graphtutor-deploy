@import "./page-data.wxss";

.feature-header {
  padding: 4rpx 0 28rpx;
}

.feature-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 10rpx;
}

.feature-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.toolbar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.tool-chip {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  background: rgba(21, 101, 192, 0.06);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
}

.tool-chip--active {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.tool-chip--primary {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.item-card {
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(21, 101, 192, 0.04);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  margin-bottom: 14rpx;
}

.item-card:active {
  background: rgba(21, 101, 192, 0.1);
}

.item-card:last-child {
  margin-bottom: 0;
}

.item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  line-height: 1.45;
}

.item-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.item-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.item-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.rank-num {
  width: 48rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-primary);
  text-align: center;
}

.progress-bar-mini {
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(21, 101, 192, 0.12);
  margin-top: 12rpx;
  overflow: hidden;
}

.progress-bar-mini-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary));
}

.primary-action {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  margin-top: 20rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.primary-action::after {
  border: none;
}
