/* 全局按钮：去除微信默认边框，统一圆角与高度 */
button.btn,
button.btn-third,
button.state-btn,
button.quick-action-btn {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-weight: 600;
}

button.btn::after,
button.btn-third::after,
button.state-btn::after,
button.quick-action-btn::after {
  border: none;
}

.btn {
  display: block;
  font-size: 30rpx;
}

.btn--block {
  width: 100%;
}

.btn--primary {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary) 100%);
  color: #fff;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(21, 101, 192, 0.28);
}

.btn--primary[disabled] {
  opacity: 0.65;
  box-shadow: none;
}

.btn--sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
}

.btn--outline {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #fff;
  color: var(--color-primary);
  border: 2rpx solid rgba(21, 101, 192, 0.25);
}

.btn--ghost {
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: rgba(21, 101, 192, 0.06);
  color: var(--color-text-secondary);
  font-size: 26rpx;
  font-weight: 500;
}

.btn-third {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-third--miniapp {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(6, 173, 86, 0.25);
}

.btn-third[disabled] {
  opacity: 0.65;
}
