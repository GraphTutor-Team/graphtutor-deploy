.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.stat-item {
  padding: 22rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(165deg, #f7faff 0%, #eef3fc 100%);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.list-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(21, 101, 192, 0.08);
}

.list-block-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.list-row {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(21, 101, 192, 0.05);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  margin-bottom: 12rpx;
}

.list-row:last-child {
  margin-bottom: 0;
}

.list-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.45;
}

.list-row-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.state-box {
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(21, 101, 192, 0.05);
  border: 1rpx dashed rgba(21, 101, 192, 0.15);
}

.state-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.state-text--muted {
  margin-top: 8rpx;
}

.state-box .state-text {
  margin-bottom: 16rpx;
}

.state-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: rgba(21, 101, 192, 0.08);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid rgba(21, 101, 192, 0.15);
}

.state-btn::after {
  border: none;
}
