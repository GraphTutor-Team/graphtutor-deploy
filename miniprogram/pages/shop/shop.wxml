<view class="container">
  <view class="sub-header">
    <view class="sub-title">成就商城</view>
    <view class="sub-desc">使用学习积分兑换道具，与 Web 端同步</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="card">
    <view class="state-box">
      <view class="state-text">登录后查看成就商城</view>
      <button class="state-btn" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <block wx:else>
    <view wx:if="{{points != null}}" class="card points-bar">
      <text>我的积分：{{points}}</text>
    </view>

    <view class="card">
      <input class="search-input" placeholder="搜索道具" bindinput="onSearch" value="{{keyword}}" />
    </view>

    <view class="card">
      <swiper class="banner" indicator-dots autoplay interval="2800" duration="350" circular>
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <view class="banner-item">
            <image class="banner-bg" src="{{item.currentImage}}" mode="aspectFill" binderror="onBannerImageError" data-id="{{item.id}}" />
            <view class="banner-mask"></view>
            <view class="banner-content">
              <text class="banner-title">{{item.title}}</text>
              <text class="banner-sub">{{item.subTitle}}</text>
            </view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view wx:if="{{loading}}" class="state-text">加载中…</view>
    <view wx:elif="{{loadError}}" class="card">
      <view class="state-text">{{loadError}}</view>
    </view>
    <view wx:else class="card">
      <view class="section-title">道具列表</view>
      <view wx:if="{{products.length === 0}}" class="state-text state-text--muted">暂无道具</view>
      <view class="product-list">
        <view class="product-item" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}">
          <view class="cover cover--icon" bindtap="goDetail" data-id="{{item.id}}">{{item.icon || '🎁'}}</view>
          <view class="main" bindtap="goDetail" data-id="{{item.id}}">
            <view class="name">{{item.name}}</view>
            <view class="meta">{{item.category}}</view>
            <view class="desc">{{item.desc}}</view>
          </view>
          <view class="right">
            <view class="price">{{item.cost}} 积分</view>
            <button class="add-btn" size="mini" data-id="{{item.id}}" bindtap="goDetail">去兑换</button>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>
