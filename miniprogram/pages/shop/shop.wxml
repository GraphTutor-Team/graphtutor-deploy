<view class="container">
  <view class="sub-header">
    <view class="sub-title">简易商城</view>
    <view class="sub-desc">课程包与题单雏形，后续可接入后端商品与订单接口。</view>
  </view>

  <view class="card">
    <view class="search-row">
      <input class="search-input" placeholder="搜索商品/分类" bindinput="onSearch" value="{{keyword}}" />
      <button class="cart-btn" bindtap="goCart">购物车</button>
    </view>
  </view>

  <view class="card">
    <swiper class="banner" indicator-dots autoplay interval="2800" duration="350" circular>
      <swiper-item wx:for="{{banners}}" wx:key="id">
        <view class="banner-item">
          <image class="banner-bg" src="{{item.currentImage}}" mode="aspectFill" binderror="onBannerImageError" data-id="{{item.id}}" />
          <view class="banner-mask"></view>
          <view class="banner-content">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-sub">{{item.subTitle}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <view class="card">
    <view class="section-title">商品列表</view>
    <view class="product-list">
      <view class="product-item" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}">
        <image class="cover" src="{{item.currentCover}}" mode="aspectFill" bindtap="goDetail" data-id="{{item.id}}" binderror="onProductImageError" />
        <view class="main" bindtap="goDetail" data-id="{{item.id}}">
          <view class="name">{{item.name}}</view>
          <view class="meta">{{item.category}} · 库存 {{item.stock}}</view>
          <view class="desc">{{item.desc}}</view>
        </view>
        <view class="right">
          <view class="price">¥{{item.price}}</view>
          <button class="add-btn" size="mini" data-id="{{item.id}}" bindtap="addToCart">加入</button>
        </view>
      </view>
    </view>
  </view>
</view>
