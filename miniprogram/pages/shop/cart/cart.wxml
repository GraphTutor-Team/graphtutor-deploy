<view class="container">
  <view class="card">
    <view class="section-title">购物车</view>
    <view wx:if="{{items.length === 0}}" class="section-text">购物车为空。</view>
    <view wx:else>
      <view class="item" wx:for="{{items}}" wx:key="id">
        <image class="cover" src="{{item.cover}}" mode="aspectFit" />
        <view class="main">
          <view class="name">{{item.name}}</view>
          <view class="price">¥{{item.price}}</view>
        </view>
        <view class="ops">
          <button class="op" size="mini" data-id="{{item.id}}" bindtap="minus">-</button>
          <text class="count">{{item.count}}</text>
          <button class="op" size="mini" data-id="{{item.id}}" bindtap="plus">+</button>
        </view>
      </view>
      <view class="total">合计：¥{{total}}</view>
      <view class="actions">
        <button class="clear" bindtap="clearAll">清空</button>
        <button class="checkout" bindtap="checkout">提交订单</button>
      </view>
    </view>
  </view>
</view>
