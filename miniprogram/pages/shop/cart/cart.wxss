.item { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; border-bottom: 1rpx solid var(--color-border); }
.cover { width: 72rpx; height: 72rpx; flex-shrink: 0; }
.main { flex: 1; }
.name { font-size: 26rpx; color: var(--color-text); font-weight: 700; }
.price { font-size: 24rpx; color: var(--color-primary); margin-top: 4rpx; }
.ops { display: flex; align-items: center; gap: 8rpx; }
.op { width: 48rpx; height: 48rpx; line-height: 48rpx; padding: 0; border-radius: 24rpx; }
.op::after { border: none; }
.count { min-width: 24rpx; text-align: center; }
.total { margin-top: 18rpx; text-align: right; font-size: 30rpx; font-weight: 800; color: var(--color-text); }
.actions { margin-top: 14rpx; display: flex; gap: 10rpx; }
.clear { flex: 1; border-radius: 30rpx; }
.checkout { flex: 1; border-radius: 30rpx; background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary)); color: #fff; border: none; }
.checkout::after { border: none; }
