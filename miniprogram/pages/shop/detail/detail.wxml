<view class="container">
  <view wx:if="{{loading}}" class="state-text">加载中…</view>
  <view class="card" wx:elif="{{product}}">
    <view class="cover cover--icon">{{product.icon || '🎁'}}</view>
    <view class="name">{{product.name}}</view>
    <view class="meta">{{product.category}}</view>
    <view class="price">{{product.cost}} 积分</view>
    <view class="desc">{{product.desc}}</view>
    <view class="points-hint" wx:if="{{points != null}}">当前积分：{{points}}</view>
    <button class="buy-btn" bindtap="purchase" loading="{{purchasing}}" disabled="{{purchasing}}">积分兑换</button>
  </view>
  <view class="card" wx:else>
    <view class="section-title">道具不存在</view>
    <view class="section-text">请返回商城列表重新选择。</view>
  </view>
</view>
