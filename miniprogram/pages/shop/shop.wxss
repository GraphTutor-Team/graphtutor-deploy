.search-row { display: flex; gap: 12rpx; align-items: center; }
.search-input {
  flex: 1; height: 72rpx; padding: 0 18rpx; border-radius: 36rpx;
  border: 1rpx solid var(--color-border); background: #fff; box-sizing: border-box;
}
.cart-btn {
  height: 72rpx; line-height: 72rpx; border-radius: 36rpx; padding: 0 22rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff; border: none; font-weight: 700;
}
.cart-btn::after { border: none; }

.banner { width: 100%; height: 240rpx; border-radius: 20rpx; overflow: hidden; }
.banner-item {
  position: relative;
  height: 100%;
}
.banner-bg {
  width: 100%;
  height: 100%;
}
.banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(9, 43, 94, .72), rgba(24, 94, 171, .36));
}
.banner-content {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #fff;
}
.banner-title { font-size: 34rpx; font-weight: 800; margin-bottom: 10rpx; }
.banner-sub { font-size: 24rpx; opacity: .92; }

.product-list { display: flex; flex-direction: column; gap: 14rpx; }
.product-item {
  display: flex; gap: 14rpx; padding: 16rpx; border-radius: 16rpx;
  border: 1rpx solid rgba(21,101,192,.12); background: rgba(21,101,192,.03);
}
.cover { width: 108rpx; height: 108rpx; flex-shrink: 0; border-radius: 12rpx; background: #f4f7fc; }
.main { flex: 1; min-width: 0; }
.name { font-size: 28rpx; font-weight: 700; color: var(--color-text); }
.meta { margin-top: 4rpx; font-size: 22rpx; color: var(--color-text-muted); }
.desc { margin-top: 6rpx; font-size: 24rpx; color: var(--color-text-secondary); }
.right { width: 130rpx; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; }
.price { font-size: 30rpx; color: var(--color-primary); font-weight: 800; }
.add-btn {
  height: 56rpx; line-height: 56rpx; border-radius: 28rpx; padding: 0 16rpx;
  background: rgba(21,101,192,.10); color: var(--color-primary); border: 1rpx solid rgba(21,101,192,.25);
}
.add-btn::after { border: none; }
