/* 登录页 */
.login-header {
  padding: 20rpx 0 44rpx;
  text-align: center;
}

.login-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7db3ef, #4f8fd8);
  margin: 0 auto 28rpx;
  box-shadow: 0 0 20rpx rgba(79, 143, 216, 0.32);
}

.login-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.login-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.card--form {
  padding: 44rpx 36rpx 52rpx;
}

.mode-switch {
  display: flex;
  background: #edf2fa;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 26rpx;
  border: 1rpx solid #e3eaf6;
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  color: #6f7f9e;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.mode-btn--active {
  background: #f8fbff;
  color: #2f6fb5;
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(63, 114, 175, 0.12);
}

.form-pane {
  margin-bottom: 20rpx;
}

.password-wrap {
  position: relative;
  margin-bottom: 10rpx;
}

.form-input--pwd {
  padding-right: 108rpx;
}

.pwd-toggle {
  position: absolute;
  right: 22rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.sms-row {
  display: flex;
  gap: 14rpx;
  align-items: stretch;
  margin-bottom: 10rpx;
}

.form-input--sms {
  flex: 1;
}

.btn-sms {
  width: 210rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 18rpx;
  background: linear-gradient(180deg, #f5f8fe 0%, #edf3fb 100%);
  color: #5b6f92;
  font-size: 24rpx;
  padding: 0;
  border: 1rpx solid #dfe7f4;
}

.btn-sms::after {
  border: none;
}

.split-line {
  position: relative;
  text-align: center;
  margin: 28rpx 0 20rpx;
}

.split-line::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  border-top: 1rpx solid #e6ebf5;
}

.split-line text {
  position: relative;
  padding: 0 24rpx;
  background: #fff;
  color: #97a2bb;
  font-size: 22rpx;
}

.btn-third {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.btn-third::after {
  border: none;
}

.btn-third--github {
  background: linear-gradient(180deg, #f5f7fb 0%, #ebf0f8 100%);
  color: #4b5d7d;
  border: 1rpx solid #dbe4f2;
}

.btn-third--wechat {
  background: linear-gradient(180deg, #7fcf96 0%, #63b77d 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(73, 145, 96, 0.18);
}

.btn-third--miniapp {
  background: linear-gradient(180deg, #6fc987 0%, #56ad70 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(73, 145, 96, 0.16);
}

.register-line {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 8rpx;
  color: #6f7f9e;
  font-size: 24rpx;
}

.register-link {
  color: var(--color-primary);
  margin-left: 10rpx;
  font-weight: 600;
}

.form-label {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-text);
  background: linear-gradient(180deg, #fbfcff 0%, #f4f7fc 100%);
  border-radius: 20rpx;
  border: 2rpx solid #e1e8f4;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #8eb5e7;
  background: #fff;
}

.form-error {
  font-size: 26rpx;
  color: var(--color-error);
  margin-bottom: 24rpx;
}

.btn--block {
  width: 100%;
  margin-top: 16rpx;
}

.btn--primary {
  background: linear-gradient(135deg, #6ea7e6 0%, #4f8fd8 52%, #3f79be 100%);
  color: #fff;
  border: none;
  font-weight: 600;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  box-shadow: 0 10rpx 24rpx rgba(63, 121, 190, 0.22);
}

.btn--primary::after {
  border: none;
}

.login-tip {
  margin-top: 40rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(79, 143, 216, 0.08) 0%, rgba(136, 177, 226, 0.08) 100%);
  border-radius: 22rpx;
  border: 1rpx solid rgba(79, 143, 216, 0.16);
  border-left: 8rpx solid #7aa9df;
}

.login-tip text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.5;
}
