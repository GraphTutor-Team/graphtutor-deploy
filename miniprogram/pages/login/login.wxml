<view class="container">
  <view class="login-header">
    <view class="login-dot"></view>
    <view class="login-title">登录 GraphTutor</view>
    <view class="login-desc">使用账号登录，开始练习与考试</view>
  </view>

  <view class="card card--form">
    <view class="mode-switch">
      <view class="{{passwordTabClass}}" data-mode="password" bindtap="switchMode">邮箱密码</view>
      <view class="{{smsTabClass}}" data-mode="sms" bindtap="switchMode">手机验证码</view>
    </view>

    <view class="form-error" wx:if="{{error}}">{{error}}</view>

    <view wx:if="{{isPasswordMode}}" class="form-pane">
      <text class="form-label">邮箱</text>
      <input
        class="form-input"
        type="text"
        placeholder="your@email.com"
        value="{{email}}"
        bindinput="onEmailInput"
      />

      <text class="form-label">密码</text>
      <view class="password-wrap">
        <input
          class="form-input form-input--pwd"
          password="{{!showPassword}}"
          placeholder="至少 6 位"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <text class="pwd-toggle" bindtap="togglePassword">{{passwordToggleText}}</text>
      </view>

      <button class="btn btn--primary btn--block" loading="{{loading}}" disabled="{{loading}}" bindtap="submitPassword">登录</button>
    </view>

    <view wx:if="{{isSmsMode}}" class="form-pane">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phoneNumber}}" bindinput="onPhoneInput" />

      <text class="form-label">验证码</text>
      <view class="sms-row">
        <input class="form-input form-input--sms" type="number" maxlength="6" placeholder="6 位验证码" value="{{smsCode}}" bindinput="onSmsCodeInput" />
        <button class="btn-sms" disabled="{{!canSendSms}}" bindtap="sendSmsCode">{{smsSendText}}</button>
      </view>

      <button class="btn btn--primary btn--block" loading="{{loading}}" disabled="{{loading}}" bindtap="submitSms">登录</button>
    </view>

    <view class="split-line"><text>或</text></view>

    <button class="btn-third btn-third--github" loading="{{githubLoading}}" disabled="{{githubLoading || loading}}" bindtap="onGithubLogin">使用 GitHub 登录</button>
    <button class="btn-third btn-third--wechat" loading="{{wechatLoading}}" disabled="{{wechatLoading || loading}}" bindtap="onWechatScanLogin">使用微信扫码登录</button>
    <button class="btn-third btn-third--miniapp" loading="{{mpLoading}}" disabled="{{mpLoading || loading}}" bindtap="onMiniProgramIdentifyLogin">微信小程序识别登录</button>

    <view class="register-line">
      <text>还没有账号？</text>
      <text class="register-link" bindtap="goRegisterTip">去注册</text>
    </view>
  </view>

  <view class="login-tip" wx:if="{{useVirtual}}">
    <text>当前为虚拟登录模式，后端接入后会自动切换真实接口。</text>
  </view>
</view>
