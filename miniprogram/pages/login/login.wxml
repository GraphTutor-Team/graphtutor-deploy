<view class="container">
  <view class="login-header">
    <view class="login-dot"></view>
    <view class="login-title">登录 GraphTutor</view>
    <view class="login-desc">邮箱密码或微信快捷登录，与 Web 端账号同步</view>
  </view>

  <view class="card card--form">
    <view class="form-error" wx:if="{{error}}">{{error}}</view>

    <text class="form-label">邮箱</text>
    <input
      class="form-input"
      type="text"
      placeholder="your@email.com"
      value="{{email}}"
      bindinput="onEmailInput"
    />

    <text class="form-label">密码</text>
    <view class="password-wrap">
      <input
        class="form-input form-input--pwd"
        password="{{!showPassword}}"
        placeholder="至少 6 位"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
      <text class="pwd-toggle" bindtap="togglePassword">{{passwordToggleText}}</text>
    </view>

    <button class="btn btn--primary btn--block" loading="{{loading}}" disabled="{{loading || mpLoading}}" bindtap="submitPassword">登录</button>

    <view class="split-line"><text>或</text></view>

    <button class="btn-third btn-third--miniapp" loading="{{mpLoading}}" disabled="{{mpLoading || loading}}" bindtap="onMiniProgramLogin">微信快捷登录</button>

    <view class="register-line">
      <text>还没有账号？</text>
      <text class="register-link" bindtap="goRegister">去注册</text>
    </view>
  </view>

  <view class="login-tip" wx:if="{{useVirtual}}">
    <text>当前为虚拟登录模式，请在 utils/config.js 关闭 USE_VIRTUAL_LOGIN。</text>
  </view>
</view>
