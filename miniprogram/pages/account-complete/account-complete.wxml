<view class="container container--auth">
  <view class="login-header">
    <view class="login-dot"></view>
    <view class="login-title">完善账号信息</view>
    <view class="login-desc">微信快捷登录后，请绑定 Web 账号或设置邮箱密码，以便同步学习数据</view>
  </view>

  <view class="card card--form">
    <view class="mode-switch">
      <view class="{{linkTabClass}}" data-mode="link" bindtap="switchMode">绑定已有账号</view>
      <view class="{{registerTabClass}}" data-mode="register" bindtap="switchMode">完善新账号</view>
    </view>

    <view class="hint-box" wx:if="{{isLinkMode}}">
      <text>若你已在浏览器注册过 GraphTutor，请填写相同邮箱和密码完成绑定。</text>
    </view>
    <view class="hint-box" wx:else>
      <text>首次使用可设置邮箱与密码，之后在 Web 与小程序均可登录同一账号。</text>
    </view>

    <view class="form-error" wx:if="{{error}}">{{error}}</view>

    <view class="form-field">
      <text class="form-label">邮箱</text>
      <view class="input-box">
        <input class="form-input-inner" type="text" placeholder="your@email.com" value="{{email}}" bindinput="onEmailInput" />
      </view>
    </view>

    <view class="form-field">
      <text class="form-label">密码</text>
      <view class="input-box input-box--password">
        <input
          wx:if="{{showPassword}}"
          class="form-input-inner"
          type="text"
          placeholder="至少 6 位"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <input
          wx:else
          class="form-input-inner"
          password
          placeholder="至少 6 位"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <view class="pwd-toggle" catchtap="togglePassword" hover-class="pwd-toggle--active">{{passwordToggleText}}</view>
      </view>
    </view>

    <block wx:if="{{isRegisterMode}}">
      <view class="form-field">
        <text class="form-label">确认密码</text>
        <view class="input-box">
          <input
            wx:if="{{showPassword}}"
            class="form-input-inner"
            type="text"
            placeholder="再次输入密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
          <input
            wx:else
            class="form-input-inner"
            password
            placeholder="再次输入密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPasswordInput"
          />
        </view>
      </view>

      <view class="form-field">
        <text class="form-label">昵称（选填）</text>
        <view class="input-box">
          <input class="form-input-inner" placeholder="如何称呼你" value="{{name}}" bindinput="onNameInput" />
        </view>
      </view>

      <view class="form-field">
        <text class="form-label">学校（选填）</text>
        <view class="input-box">
          <input class="form-input-inner" placeholder="例如：某某大学" value="{{school}}" bindinput="onSchoolInput" />
        </view>
      </view>

      <view class="form-field">
        <text class="form-label">年级（选填）</text>
        <view class="input-box">
          <input class="form-input-inner" placeholder="例如：大二" value="{{grade}}" bindinput="onGradeInput" />
        </view>
      </view>
    </block>

    <view class="form-actions">
      <button class="btn btn--primary btn--block" loading="{{loading}}" disabled="{{loading}}" bindtap="submit">
        {{isLinkMode ? '绑定并同步' : '完成注册'}}
      </button>
    </view>
  </view>
</view>
