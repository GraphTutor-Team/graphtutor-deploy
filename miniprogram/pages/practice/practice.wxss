@import "../../styles/page-data.wxss";

.quiz-start-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 12rpx 28rpx rgba(21, 101, 192, 0.28);
}

.quiz-start-btn::after {
  border: none;
}

.ongoing-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-sm);
  background: rgba(255, 152, 0, 0.12);
  border: 1rpx solid rgba(255, 152, 0, 0.25);
}

.ongoing-title {
  font-size: 26rpx;
  color: #e65100;
  font-weight: 600;
}

.ongoing-action {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.quick-links {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.quick-link {
  flex: 1;
  min-width: 180rpx;
  text-align: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(21, 101, 192, 0.08);
  border: 1rpx solid rgba(21, 101, 192, 0.12);
}

.page-banner {
  position: relative;
  height: 220rpx;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.page-banner-bg {
  width: 100%;
  height: 100%;
}

.page-banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(9, 42, 88, 0.74), rgba(31, 95, 170, 0.4));
}

.page-banner-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #fff;
}

.page-banner-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.page-banner-sub {
  font-size: 24rpx;
  opacity: 0.92;
}

.grid {
  display: flex;
  gap: 22rpx;
}

.tile {
  flex: 1;
  background: linear-gradient(165deg, #ffffff 0%, #f5f8ff 100%);
  border-radius: 22rpx;
  padding: 24rpx 22rpx 28rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.08);
  box-shadow: 0 8rpx 28rpx rgba(21, 101, 192, 0.06);
}

.tile-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  text-align: center;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(21, 101, 192, 0.22);
}

.tile-icon-img {
  width: 38rpx;
  height: 38rpx;
}

.tile-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.tile-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.35;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.row:last-child {
  border-bottom: none;
}

.row-left {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.row-right {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.rec-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.rec-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(21, 101, 192, 0.05);
  border: 1rpx solid rgba(21, 101, 192, 0.12);
}

.rec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.rec-meta {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
}

.rec-level {
  font-size: 24rpx;
  color: var(--color-primary);
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(21, 101, 192, 0.1);
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.log-item:last-child {
  border-bottom: none;
}

.log-title {
  font-size: 27rpx;
  color: var(--color-text);
  font-weight: 600;
}

.log-time {
  font-size: 23rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.log-score {
  min-width: 72rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-primary);
}
