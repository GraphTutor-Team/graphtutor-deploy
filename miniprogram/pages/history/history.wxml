<view class="container">
  <view class="feature-header">
    <view class="feature-title">测验会话</view>
    <view class="feature-desc">历史测验记录，与 Web 端同步</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="card">
    <view class="state-box">
      <view class="state-text">登录后查看记录</view>
      <button class="state-btn" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="state-text">加载中…</view>
  <view wx:elif="{{loadError}}" class="card">
    <view class="state-box">
      <view class="state-text">{{loadError}}</view>
      <button class="state-btn" bindtap="reload">重试</button>
    </view>
  </view>

  <block wx:else>
    <view class="card">
      <view wx:if="{{items.length === 0}}" class="state-text state-text--muted">暂无测验会话，先去刷题吧</view>
      <view
        class="item-card item-row"
        wx:for="{{items}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="openSession"
      >
        <view>
          <view class="item-title">正确率 {{item.accText}}</view>
          <view class="item-meta">{{item.timeText}} · {{item.scoreText}}</view>
        </view>
        <view class="item-action">查看 ›</view>
      </view>
    </view>
  </block>
</view>
