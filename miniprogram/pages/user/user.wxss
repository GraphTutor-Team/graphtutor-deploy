@import "../../styles/page-data.wxss";

.user-header {  padding: 32rpx 0 40rpx;
  text-align: center;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 128rpx;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(21, 101, 192, 0.28), 0 0 0 6rpx rgba(255, 255, 255, 0.95), 0 0 0 8rpx rgba(21, 101, 192, 0.12);
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  display: block;
  box-shadow: 0 12rpx 40rpx rgba(21, 101, 192, 0.22), 0 0 0 6rpx rgba(255, 255, 255, 0.95), 0 0 0 8rpx rgba(21, 101, 192, 0.12);
}

.user-name {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 10rpx;
  letter-spacing: 0.5rpx;
}

.user-email {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.user-role {
  margin-top: 12rpx;
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  background: rgba(21, 101, 192, 0.08);
  border: 1rpx solid rgba(21, 101, 192, 0.12);
}

.guest-header {
  text-align: center;
  padding: 24rpx 0 36rpx;
}

.guest-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.85;
}

.guest-title {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 10rpx;
}

.guest-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.warn-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.warn-text {
  flex: 1;
  font-size: 26rpx;
  color: #e65100;
  line-height: 1.45;
}

.menu-list {
  display: flex;
  flex-direction: column;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 4rpx;
  border-bottom: 1rpx solid rgba(21, 101, 192, 0.08);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: linear-gradient(160deg, #edf3ff 0%, #e0ebff 100%);
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
}

.menu-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: rgba(21, 101, 192, 0.35);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.info-row:last-of-type {
  border-bottom: none;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.info-value {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 500;
}

.info-value--ok {
  color: #2e7d32;
}

.info-value--fail {
  color: #c62828;
}

.btn--sm {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
}

.card--actions {
  padding-top: 28rpx;
  padding-bottom: 28rpx;
}

.card--list {  padding: 0;
  overflow: hidden;
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 36rpx;
  border-bottom: 1rpx solid var(--color-border);
  background: #fff;
}

.list-item:last-child {
  border-bottom: none;
}

.list-label {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.list-value {
  font-size: 28rpx;
  color: var(--color-text);
  font-weight: 500;
}

.list-value--muted {
  font-weight: 400;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.list-value--warn {
  color: #e65100;
}

.list-item--warn {
  background: rgba(230, 81, 0, 0.04);
}

.card--empty .btn--primary {
  margin-bottom: 20rpx;
}

.card--empty {
  padding: 40rpx;
  text-align: center;
}

.empty-desc {
  font-size: 28rpx;
  color: var(--color-text-muted);
  margin-bottom: 32rpx;
}

.btn--block {
  width: 100%;
}

.btn--primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border: none;
  font-weight: 500;
  height: 88rpx;
  line-height: 88rpx;
}

.btn--primary::after {
  border: none;
}

.btn--outline {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  color: var(--color-error);
  background: rgba(198, 40, 40, 0.04);
  border: 2rpx solid rgba(198, 40, 40, 0.45);
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn--outline::after {
  border: none;
}

.card--dev {
  padding: 32rpx 32rpx 36rpx;
  background: linear-gradient(165deg, #ffffff 0%, #f7f9ff 100%);
}

.dev-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 22rpx;
  display: flex;
  align-items: center;
}

.dev-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, var(--color-primary-light), var(--color-primary));
}

.dev-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 14rpx;
}

.dev-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.dev-value {
  font-size: 24rpx;
  color: var(--color-text);
  font-weight: 500;
  text-align: right;
  word-break: break-all;
}

.dev-value--url {
  font-weight: 400;
  color: var(--color-primary);
}

.dev-value--ok {
  color: #2e7d32;
}

.dev-value--fail {
  color: #c62828;
}

.btn--ghost {
  width: 100%;
  margin-top: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: var(--color-primary);
  background: #f5f8ff;
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.btn--ghost::after {
  border: none;
}

.dev-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
