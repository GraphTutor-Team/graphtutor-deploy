<view class="container">
  <view class="user-header" wx:if="{{isLoggedIn}}">
    <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <view wx:else class="avatar">{{userFirstChar}}</view>
    <view class="user-name">{{userInfo.name || '未设置昵称'}}</view>
    <view class="user-email">{{userInfo.email || '—'}}</view>
    <view class="user-role">{{roleText}}</view>
  </view>

  <view class="guest-header" wx:else>
    <image class="guest-icon" src="{{icons.user}}" mode="aspectFit" />
    <view class="guest-title">登录 GraphTutor</view>
    <view class="guest-desc">同步 Web 端练习、计划与错题数据</view>
    <button class="btn btn--primary btn--block" bindtap="goLogin">去登录</button>
  </view>

  <view class="card" wx:if="{{isLoggedIn && needsComplete}}">
    <view class="warn-row">
      <text class="warn-text">账号待完善，请绑定邮箱以同步学习数据</text>
      <button class="btn btn--primary btn--sm" bindtap="goCompleteAccount">去完善</button>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="section-title">学习中心</view>
    <view class="menu-list">
      <view class="menu-row" wx:for="{{learningCenter}}" wx:key="title" data-url="{{item.url}}" bindtap="onToolTap">
        <image class="menu-icon" src="{{icons[item.iconKey]}}" mode="aspectFit" />
        <view class="menu-body">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="section-title">学习工具</view>
    <view class="menu-list">
      <view class="menu-row" wx:for="{{learningTools}}" wx:key="title" data-url="{{item.url}}" data-tab="{{item.tab}}" bindtap="onToolTap">
        <image class="menu-icon" src="{{icons[item.iconKey]}}" mode="aspectFit" />
        <view class="menu-body">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="section-title">学习分析</view>
    <view class="menu-list">
      <view class="menu-row" wx:for="{{learningAnalysis}}" wx:key="title" data-url="{{item.url}}" bindtap="onToolTap">
        <image class="menu-icon" src="{{icons[item.iconKey]}}" mode="aspectFit" />
        <view class="menu-body">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="section-title">社交与社区</view>
    <view class="menu-list">
      <view class="menu-row" wx:for="{{socialTools}}" wx:key="title" data-url="{{item.url}}" data-action="{{item.action}}" bindtap="onToolTap">
        <image class="menu-icon" src="{{icons[item.iconKey]}}" mode="aspectFit" />
        <view class="menu-body">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="section-title">个人中心</view>
    <view class="menu-list">
      <view class="menu-row" wx:for="{{profileTools}}" wx:key="title" data-url="{{item.url}}" bindtap="onToolTap">
        <image class="menu-icon" src="{{icons[item.iconKey]}}" mode="aspectFit" />
        <view class="menu-body">
          <view class="menu-title">{{item.title}}</view>
          <view class="menu-desc">{{item.desc}}</view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card card--actions" wx:if="{{isLoggedIn}}">
    <button class="btn btn--outline btn--block" bindtap="logout">退出登录</button>
  </view>
</view>
