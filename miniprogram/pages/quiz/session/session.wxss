@import "../../../styles/page-data.wxss";

.session-page {
  padding-bottom: calc(env(safe-area-inset-bottom) + 48rpx);
}

.review-summary {
  margin-bottom: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(46, 125, 50, 0.1);
  border: 1rpx solid rgba(46, 125, 50, 0.2);
  font-size: 26rpx;
  color: #2e7d32;
  font-weight: 600;
}

.center-state {
  text-align: center;
  padding: 80rpx 0;
}

.progress-bar {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(21, 101, 192, 0.12);
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--color-primary-light), var(--color-primary));
  transition: width 0.25s ease;
}

.progress-text {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 24rpx;
}

.question-card {
  margin-bottom: 24rpx;
}

.question-content {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.6;
  margin-bottom: 28rpx;
  white-space: pre-wrap;
}

.coding-tip {
  padding: 24rpx;
  border-radius: 18rpx;
  background: rgba(255, 152, 0, 0.1);
  border: 1rpx solid rgba(255, 152, 0, 0.25);
  font-size: 26rpx;
  color: #e65100;
  line-height: 1.5;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(21, 101, 192, 0.04);
  border: 2rpx solid rgba(21, 101, 192, 0.1);
}

.option-item--selected {
  background: rgba(21, 101, 192, 0.12);
  border-color: var(--color-primary);
}

.option-letter {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #fff;
  color: var(--color-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.option-item--selected .option-letter {
  background: var(--color-primary);
  color: #fff;
}

.option-item--correct {
  background: rgba(46, 125, 50, 0.12);
  border-color: #2e7d32;
}

.option-item--correct .option-letter {
  background: #2e7d32;
  color: #fff;
}

.option-item--wrong {
  background: rgba(211, 47, 47, 0.1);
  border-color: #d32f2f;
}

.option-item--wrong .option-letter {
  background: #d32f2f;
  color: #fff;
}

.review-verdict {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.review-verdict--ok {
  background: rgba(46, 125, 50, 0.12);
  color: #2e7d32;
}

.review-verdict--bad {
  background: rgba(211, 47, 47, 0.1);
  color: #d32f2f;
}

.review-verdict--empty {
  background: rgba(158, 158, 158, 0.12);
  color: #757575;
}

.explain-block {
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(21, 101, 192, 0.06);
  border: 1rpx solid rgba(21, 101, 192, 0.12);
}

.explain-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 10rpx;
}

.explain-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  white-space: pre-wrap;
}

.skip-coding-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 16rpx;
  border-radius: 36rpx;
  background: rgba(21, 101, 192, 0.08);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

.skip-coding-btn::after {
  border: none;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.footer-actions {
  display: flex;
  gap: 20rpx;
}

.foot-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: rgba(21, 101, 192, 0.08);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.foot-btn::after {
  border: none;
}

.foot-btn--primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(21, 101, 192, 0.24);
}

.foot-btn[disabled] {
  opacity: 0.5;
}

.result-wrap {
  padding-top: 40rpx;
}

.result-card {
  background: linear-gradient(165deg, #ffffff 0%, #f7faff 100%);
  border-radius: 28rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  box-shadow: var(--shadow-card);
  padding: 48rpx 36rpx;
  text-align: center;
}

.result-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.result-score {
  font-size: 72rpx;
  font-weight: 800;
  color: var(--color-primary);
  line-height: 1.1;
  margin-bottom: 12rpx;
}

.result-meta {
  font-size: 28rpx;
  color: var(--color-text-muted);
  margin-bottom: 36rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.result-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: rgba(21, 101, 192, 0.08);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.result-btn::after {
  border: none;
}

.result-btn--primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
}

.exam-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(21, 101, 192, 0.08);
}

.practice-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(46, 125, 50, 0.08);
}

.practice-progress {
  font-size: 26rpx;
  color: #2e7d32;
  font-weight: 600;
}

.fill-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.fill-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.fill-label {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.fill-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.2);
  background: #fff;
  font-size: 28rpx;
}

.short-wrap {
  margin-top: 8rpx;
}

.short-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.2);
  background: #fff;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.exam-timer {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.exam-limit {
  font-size: 24rpx;
  color: var(--color-text-muted);
  flex: 1;
}

.exam-sheet-btn {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.submit-exam-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 16rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #e65100, #ff9800);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.submit-exam-btn::after {
  border: none;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sheet-panel {
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.sheet-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.sheet-cell {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 12rpx;
  background: rgba(21, 101, 192, 0.06);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-muted);
}

.sheet-cell--done {
  background: rgba(46, 125, 50, 0.15);
  color: #2e7d32;
}

.sheet-cell--cur {
  border: 2rpx solid var(--color-primary);
}

.sheet-cell--ok {
  background: rgba(46, 125, 50, 0.18);
  color: #2e7d32;
}

.sheet-cell--bad {
  background: rgba(211, 47, 47, 0.15);
  color: #d32f2f;
}
