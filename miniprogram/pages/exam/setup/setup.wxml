<view class="container">
  <view class="sub-header">
    <view class="sub-title">考试模式</view>
    <view class="sub-desc">计时答题、答题卡跳题，交卷后查看详细结果</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="card">
    <view class="state-box">
      <view class="state-text">登录后开始考试</view>
      <button class="state-btn" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section-title">考试设置</view>
      <view wx:if="{{loadingBanks}}" class="state-text">加载题库…</view>
      <view wx:elif="{{banks.length === 0}}" class="state-text">暂无可用题库</view>
      <block wx:else>
        <view class="field">
          <view class="field-label">题库</view>
          <picker mode="selector" range="{{bankNames}}" value="{{bankIndex}}" bindchange="onBankChange">
            <view class="picker-value">{{bankNames[bankIndex]}}</view>
          </picker>
          <view wx:if="{{selectedBankDesc}}" class="field-hint">{{selectedBankDesc}}</view>
        </view>
        <view class="field">
          <view class="field-label">学科</view>
          <picker mode="selector" range="{{subjectNames}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
            <view class="picker-value">{{subjectNames[subjectIndex]}}</view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">题量</view>
          <picker mode="selector" range="{{sizeLabels}}" value="{{sizeIndex}}" bindchange="onSizeChange">
            <view class="picker-value">{{sizeLabels[sizeIndex]}}</view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">考试时长</view>
          <picker mode="selector" range="{{timeLabels}}" value="{{timeIndex}}" bindchange="onTimeChange">
            <view class="picker-value">{{timeLabels[timeIndex]}}</view>
          </picker>
        </view>
        <view class="field">
          <view class="field-label">难度</view>
          <picker mode="selector" range="{{difficultyLabels}}" value="{{difficultyIndex}}" bindchange="onDifficultyChange">
            <view class="picker-value">{{difficultyLabels[difficultyIndex]}}</view>
          </picker>
        </view>
      </block>
    </view>
    <button wx:if="{{banks.length > 0}}" class="start-btn" loading="{{starting}}" bindtap="startExam">开始考试</button>
  </block>
</view>
