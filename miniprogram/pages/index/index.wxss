/* Hero */
.backend-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.backend-bar--ok {
  background: rgba(46, 125, 50, 0.08);
  color: #2e7d32;
  border: 1rpx solid rgba(46, 125, 50, 0.16);
}

.backend-bar--fail {
  background: rgba(211, 47, 47, 0.06);
  color: #c62828;
  border: 1rpx solid rgba(211, 47, 47, 0.14);
}

.backend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.backend-dot--ok {
  background: #43a047;
}

.backend-dot--fail {
  background: #e53935;
}

.index-hero {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx 26rpx;
  box-shadow: 0 14rpx 36rpx rgba(21, 101, 192, 0.14);
}

.index-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.index-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(9, 42, 88, 0.74), rgba(31, 95, 170, 0.4));
}

.index-hero-badge {
  position: relative;
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--color-primary);
  background: rgba(255, 255, 255, 0.75);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.12);
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(21, 101, 192, 0.06);
}

.index-hero-title {
  position: relative;
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.index-hero-desc {
  position: relative;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.45;
}

/* 用户条 */
.user-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid rgba(21, 101, 192, 0.08);
  box-shadow: 0 8rpx 24rpx rgba(21, 101, 192, 0.06);
}

.user-strip-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.user-strip-avatar,
.user-strip-char {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-strip-char {
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-weight: 800;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-strip-meta {
  min-width: 0;
}

.user-strip-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-strip-sub {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

.user-strip-link {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  padding: 8rpx 0 8rpx 16rpx;
}

/* 未登录条 */
.guest-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(165deg, #ffffff 0%, #f7fbff 100%);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
}

.guest-bar-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.45;
}

.guest-bar-btn {
  flex-shrink: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 28rpx;
  margin: 0;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
}

.guest-bar-btn::after {
  border: none;
}

/* 开始练习 */
.start-card {
  margin-bottom: 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #4f8fd8 0%, #3f79be 55%, #2f6fb5 100%);
  color: #fff;
  box-shadow: 0 14rpx 32rpx rgba(47, 111, 181, 0.22);
}

.start-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.start-desc {
  font-size: 24rpx;
  opacity: 0.92;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.start-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 42rpx;
  background: #fff;
  color: #2f6fb5;
  font-weight: 700;
  border: none;
}

.start-btn::after {
  border: none;
}

/* 学习工具列表 */
.nav-list {
  display: flex;
  flex-direction: column;
}

.nav-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid rgba(21, 101, 192, 0.08);
}

.nav-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.nav-row:first-child {
  padding-top: 4rpx;
}

.nav-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  padding: 12rpx;
  box-sizing: border-box;
  border-radius: 18rpx;
  background: linear-gradient(160deg, #edf3ff 0%, #e0ebff 100%);
}

.nav-body {
  flex: 1;
  min-width: 0;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 4rpx;
}

.nav-desc {
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.4;
}

.nav-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  color: rgba(21, 101, 192, 0.35);
  font-weight: 300;
  line-height: 1;
}

/* 学习概览 */
.overview-grid {
  display: flex;
  gap: 14rpx;
}

.overview-item {
  flex: 1;
  padding: 22rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(165deg, #f7faff 0%, #eef3fc 100%);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  text-align: center;
}

.overview-num {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.overview-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 通知与推荐 */
.feed-block + .feed-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(21, 101, 192, 0.08);
}

.feed-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
}

.feed-item {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(21, 101, 192, 0.05);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  margin-bottom: 12rpx;
}

.feed-item:last-child {
  margin-bottom: 0;
}

.feed-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text);
}

.feed-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.feed-content {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.feed-item--rec .feed-title {
  font-weight: 600;
}

/* 状态提示 */
.state-box {
  padding: 20rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(21, 101, 192, 0.05);
  border: 1rpx dashed rgba(21, 101, 192, 0.15);
}

.state-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.state-box .state-text {
  margin-bottom: 16rpx;
}

.state-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: rgba(21, 101, 192, 0.08);
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
  border: 1rpx solid rgba(21, 101, 192, 0.15);
}

.state-btn::after {
  border: none;
}
