<view class="container">
  <view class="backend-bar backend-bar--ok" wx:if="{{backendReady}}">
    <text class="backend-dot backend-dot--ok"></text>
    <text>{{backendStatusText}} · 登录后同步学习数据</text>
  </view>
  <view class="backend-bar backend-bar--fail" wx:elif="{{!backendReady && backendStatusText}}" bindtap="checkBackend">
    <text class="backend-dot backend-dot--fail"></text>
    <text>{{backendStatusText}} · 点此重试</text>
  </view>

  <view class="index-hero">
    <image class="index-hero-bg" src="{{heroImage}}" mode="aspectFill" binderror="onHeroImageError" />
    <view class="index-hero-mask"></view>
    <view class="index-hero-badge">GraphTutor</view>
    <view class="index-hero-title">图结构 · 智能练习</view>
    <view class="index-hero-desc">知识图谱、练习与计划，一站入口</view>
  </view>

  <view class="user-strip" wx:if="{{isLoggedIn}}">
    <view class="user-strip-left">
      <image
        wx:if="{{userInfo.avatarUrl}}"
        class="user-strip-avatar"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      />
      <view wx:else class="user-strip-char">{{userFirstChar}}</view>
      <view class="user-strip-meta">
        <view class="user-strip-name">{{userDisplayName}}</view>
        <view class="user-strip-sub">{{roleText}}</view>
      </view>
    </view>
    <view class="user-strip-link" bindtap="goMy">我的 ›</view>
  </view>

  <view class="guest-bar" wx:else>
    <view class="guest-bar-text">{{backendReady ? '后端已就绪，登录后同步练习进度' : '请先确保后端可访问，再登录账号'}}</view>
    <button class="guest-bar-btn" bindtap="goLogin">去登录</button>
  </view>

  <view class="start-card" wx:if="{{isLoggedIn}}">
    <view class="start-title">立即开始练习</view>
    <view class="start-desc">选择题库即可做题，错题会自动进入错题本</view>
    <button class="start-btn" bindtap="goPractice">开始练习</button>
  </view>

  <view class="card">
    <view class="section-title">学习工具</view>
    <view class="nav-list">
      <view
        class="nav-row"
        wx:for="{{navFeatures}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="featureNav"
      >
        <image class="nav-icon" src="{{item.img}}" mode="aspectFit" />
        <view class="nav-body">
          <view class="nav-title">{{item.title}}</view>
          <view class="nav-desc">{{item.desc}}</view>
        </view>
        <text class="nav-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn}}">
    <view class="section-title">学习概览</view>
    <view wx:if="{{homeLoading}}" class="state-text">加载中…</view>
    <view wx:elif="{{homeConnected}}" class="overview-grid">
      <view class="overview-item">
        <view class="overview-num">{{todayReviewCount}}</view>
        <view class="overview-label">今日需复习</view>
      </view>
      <view class="overview-item">
        <view class="overview-num">{{efficiencyScoreDisplay}}</view>
        <view class="overview-label">学习效率分</view>
      </view>
    </view>
    <view wx:else class="state-box">
      <view class="state-text">{{backendReady ? '登录态异常或数据加载失败' : '后端未连接，无法拉取数据'}}</view>
      <button class="state-btn" bindtap="{{backendReady ? 'loadHomeData' : 'checkBackend'}}">{{backendReady ? '重试' : '检测后端'}}</button>
    </view>
  </view>

  <view class="card" wx:if="{{isLoggedIn && (homeLoading || hasFeedContent || homeConnected)}}">
    <view class="section-title">通知与推荐</view>
    <view wx:if="{{homeLoading}}" class="state-text">加载中…</view>
    <block wx:else>
      <view wx:if="{{notifications.length > 0}}" class="feed-block">
        <view class="feed-label">通知</view>
        <view class="feed-item" wx:for="{{notifications}}" wx:key="id">
          <view class="feed-title">{{item.title}}</view>
          <view class="feed-meta">{{item.timeText}}</view>
          <view wx:if="{{item.content}}" class="feed-content">{{item.content}}</view>
        </view>
      </view>
      <view wx:if="{{recommendations.length > 0}}" class="feed-block">
        <view class="feed-label">推荐练习</view>
        <view class="feed-item feed-item--rec" wx:for="{{recommendations}}" wx:key="id">
          <view class="feed-title">{{item.title}}</view>
        </view>
      </view>
      <view wx:if="{{notifications.length === 0 && recommendations.length === 0}}" class="state-text">暂无新通知与推荐</view>
    </block>
  </view>
</view>
