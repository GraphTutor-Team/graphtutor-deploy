<view class="container">
  <view class="sub-header">
    <view class="sub-title">错题巩固</view>
    <view class="sub-desc">错题统计与清单，与 Web 端错题本同步</view>
  </view>

  <view class="page-banner">
    <image class="page-banner-bg" src="{{bannerImage}}" mode="aspectFill" binderror="onBannerError" />
    <view class="page-banner-mask"></view>
    <view class="page-banner-content">
      <view class="page-banner-title">{{bannerTitle}}</view>
      <view class="page-banner-sub">{{bannerSubTitle}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">错题概览</view>
    <view wx:if="{{!isLoggedIn}}" class="state-box">
      <view class="state-text">登录后查看错题统计</view>
      <button class="state-btn" bindtap="goLogin">去登录</button>
    </view>
    <view wx:elif="{{loading}}" class="state-text">加载中…</view>
    <view wx:else class="stat-grid">
      <view class="stat-item">
        <view class="stat-num">{{total}}</view>
        <view class="stat-label">错题总数</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{unmastered}}</view>
        <view class="stat-label">待巩固</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{learning}}</view>
        <view class="stat-label">学习中</view>
      </view>
      <view class="stat-item">
        <view class="stat-num">{{mastered}}</view>
        <view class="stat-label">已掌握</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-row">
      <view class="section-title">最近错题</view>
      <view class="section-link" bindtap="goReviewPlans">复习计划 ›</view>
    </view>
    <view wx:if="{{isLoggedIn}}" class="toolbar">
      <view
        class="tool-chip {{masteryTab === item.key ? 'tool-chip--active' : ''}}"
        wx:for="{{masteryTabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="switchMasteryTab"
      >{{item.label}}</view>
    </view>
    <view wx:if="{{!isLoggedIn}}" class="state-text">登录后查看错题列表</view>
    <view wx:elif="{{loading}}" class="state-text">加载中…</view>
    <block wx:else>
      <button
        wx:if="{{unmastered > 0}}"
        class="review-btn"
        bindtap="startWrongPractice"
      >
        巩固待掌握错题（{{unmastered}} 题）
      </button>
      <view wx:if="{{items.length > 0}}" class="wrong-list">
        <view
          class="wrong-card"
          wx:for="{{items}}"
          wx:key="id"
        >
          <view class="wrong-card-title">{{item.title}}</view>
          <view class="wrong-card-meta">
            <view class="wrong-tag">错误 {{item.errorCount}} 次</view>
            <view class="wrong-actions">
              <view class="wrong-status" catchtap="startSingleWrong" data-qid="{{item.questionId}}">重做</view>
              <view class="wrong-mastered" catchtap="markMastered" data-qid="{{item.questionId}}">已掌握</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:elif="{{connected}}" class="state-text state-text--muted">暂无错题，继续保持</view>
      <view wx:else class="state-box">
        <view class="state-text">暂时无法获取数据</view>
        <button class="state-btn" bindtap="reload">重试</button>
      </view>
    </block>
  </view>
</view>
