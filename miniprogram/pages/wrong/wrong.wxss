@import "../../styles/page-data.wxss";

.page-banner {
  position: relative;
  height: 220rpx;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.page-banner-bg {
  width: 100%;
  height: 100%;
}

.page-banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(9, 42, 88, 0.74), rgba(31, 95, 170, 0.4));
}

.page-banner-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #fff;
}

.page-banner-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.page-banner-sub {
  font-size: 24rpx;
  opacity: 0.92;
}

.wrong-summary {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  background: rgba(21, 101, 192, 0.06);
  border-radius: var(--radius-sm);
  border: 1rpx solid rgba(21, 101, 192, 0.08);
}

.wrong-summary-num {
  color: var(--color-primary);
  font-weight: 800;
  font-size: 34rpx;
}

.wrong-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 16rpx;
  margin: 0 -16rpx;
  border-radius: var(--radius-sm);
  border-bottom: 1rpx solid var(--color-border);
  font-size: 28rpx;
}

.wrong-row:last-child {
  border-bottom: none;
}

.wrong-row:active {
  background: rgba(21, 101, 192, 0.04);
}

.wrong-name {
  color: var(--color-text);
  font-weight: 500;
}

.wrong-pending {
  color: var(--color-primary);
  font-weight: 700;
  font-size: 26rpx;
  padding: 6rpx 16rpx;
  background: rgba(21, 101, 192, 0.08);
  border-radius: 999rpx;
}

.wrong-card {
  padding: 16rpx 16rpx;
  border-radius: 14rpx;
  background: rgba(21, 101, 192, 0.04);
  border: 1rpx solid rgba(21, 101, 192, 0.1);
  margin-bottom: 12rpx;
}

.wrong-card-title {
  font-size: 27rpx;
  color: var(--color-text);
  font-weight: 600;
  margin-bottom: 8rpx;
}

.wrong-card-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.wrong-tag {
  font-size: 23rpx;
  color: var(--color-text-muted);
}

.wrong-status {
  font-size: 23rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.review-btn {
  margin-top: 16rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  color: #fff;
  border: none;
  font-weight: 700;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
}

.review-btn::after {
  border: none;
}
