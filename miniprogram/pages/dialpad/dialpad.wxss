.dial-card {
  padding: 34rpx 30rpx 38rpx;
}

.tel-display {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 26rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(180deg, rgba(21, 101, 192, 0.06) 0%, rgba(21, 101, 192, 0.03) 100%);
  border: 1rpx solid rgba(21, 101, 192, 0.14);
  font-size: 44rpx;
  font-weight: 900;
  color: var(--color-text);
  box-sizing: border-box;
  word-break: break-all;
  letter-spacing: 2rpx;
}

.pad {
  margin-top: 28rpx;
}

.pad-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.pad-row--ops {
  margin-bottom: 22rpx;
}

.key {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f6f8ff 100%);
  border: 1rpx solid rgba(21, 101, 192, 0.14);
  font-size: 36rpx;
  font-weight: 950;
  color: var(--color-text);
}

.key::after {
  border: none;
}

.key--op {
  color: var(--color-error);
  border: 1rpx solid rgba(198, 40, 40, 0.26);
  background: linear-gradient(180deg, rgba(198, 40, 40, 0.06) 0%, rgba(198, 40, 40, 0.03) 100%);
}

.dial-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 8rpx;
}

.btn-copy {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: rgba(21, 101, 192, 0.06);
  border: 1rpx solid rgba(21, 101, 192, 0.22);
  color: var(--color-primary);
  font-weight: 900;
}

.btn-copy::after {
  border: none;
}

.btn-call {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  border: none;
  font-weight: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

