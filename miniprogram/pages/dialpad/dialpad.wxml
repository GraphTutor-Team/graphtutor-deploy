<view class="container">
  <view class="sub-header">
    <view class="sub-title">数字拨号</view>
    <view class="sub-desc">点击数字拼接号码，支持删除/清空。</view>
  </view>

  <view class="card dial-card">
    <view class="tel-display">{{tel || '尚未输入号码'}}</view>

    <view class="pad">
      <view class="pad-row">
        <button class="key" data-num="1" bindtap="onDigit">1</button>
        <button class="key" data-num="2" bindtap="onDigit">2</button>
        <button class="key" data-num="3" bindtap="onDigit">3</button>
      </view>
      <view class="pad-row">
        <button class="key" data-num="4" bindtap="onDigit">4</button>
        <button class="key" data-num="5" bindtap="onDigit">5</button>
        <button class="key" data-num="6" bindtap="onDigit">6</button>
      </view>
      <view class="pad-row">
        <button class="key" data-num="7" bindtap="onDigit">7</button>
        <button class="key" data-num="8" bindtap="onDigit">8</button>
        <button class="key" data-num="9" bindtap="onDigit">9</button>
      </view>

      <view class="pad-row pad-row--ops">
        <button class="key key--op" data-action="del" bindtap="onAction">删除</button>
        <button class="key" data-num="0" bindtap="onDigit">0</button>
        <button class="key key--op" data-action="clear" bindtap="onAction">清空</button>
      </view>
    </view>

    <view class="dial-actions">
      <button class="btn-copy" size="default" bindtap="copyTel">复制</button>
      <view class="btn-call" bindtap="callTel">
        拨号
      </view>
    </view>
  </view>
</view>

