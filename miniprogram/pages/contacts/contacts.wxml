<view class="container">
  <view class="sub-header">
    <view class="sub-title">通讯录</view>
    <view class="sub-desc">好友与社区入口</view>
  </view>

  <view class="card contacts-card">
    <view class="search-row">
      <input class="search-input" placeholder="搜索好友/备注/手机号" value="{{query}}" bindinput="onQuery" />
      <view class="pill pill--primary pill--add" bindtap="goAdd">
        新增
      </view>
    </view>

    <view class="dial-row" bindtap="goDialpad">
      <text class="dial-row-text">手动拨号</text>
      <text class="dial-row-hint">进入数字拨号器</text>
    </view>

    <view class="demo-row" bindtap="importDemoMore">
      <text class="demo-row-text">补充示例联系人</text>
      <text class="demo-row-hint">一键添加几位</text>
    </view>

    <view wx:if="{{filteredContacts.length === 0}}" class="empty">
      <text class="empty-title">暂无联系人</text>
      <text class="empty-desc">点击“新增”添加好友</text>
    </view>

    <view wx:else class="list">
      <view class="contact-item" wx:for="{{filteredContacts}}" wx:key="id">
        <view class="contact-main">
          <view class="avatar">{{item.firstChar || '用'}}</view>

          <view class="info">
            <view class="name-row">
              <text class="name">{{item.name}}</text>
              <text class="star" data-id="{{item.id}}" bindtap="toggleStar">{{item.star ? '★' : '☆'}}</text>
            </view>
            <view class="remark">{{item.remark || '—'}}</view>
            <view class="tel-row">
              <text class="tel-label">电话</text>
              <text class="tel-value">{{item.tel || '—'}}</text>
            </view>
          </view>
        </view>

        <view class="contact-actions">
          <view class="action-btn action-btn--call" data-id="{{item.id}}" bindtap="callContact">
            <text>拨号</text>
          </view>
          <view class="action-btn action-btn--del" data-id="{{item.id}}" bindtap="deleteContact">
            <text>删除</text>
          </view>
        </view>
      </view>
    </view>

    <view class="posts-section">
      <view class="posts-title-row">
        <text class="posts-title">社区动态（示意）</text>
        <text class="posts-hint">后续接入后端后可替换为实时动态</text>
      </view>

      <view class="posts-list">
        <view class="post-item" wx:for="{{posts}}" wx:key="id">
          <view class="post-avatar">{{item.authorFirstChar}}</view>
          <view class="post-body">
            <image class="post-cover" src="{{item.currentCover}}" mode="aspectFill" binderror="onPostImageError" data-id="{{item.id}}" />
            <view class="post-head">
              <text class="post-author">{{item.author}}</text>
              <text class="post-time">{{item.timeText}}</text>
            </view>
            <text class="post-postTitle">{{item.title}}</text>
            <text class="post-content">{{item.content}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
