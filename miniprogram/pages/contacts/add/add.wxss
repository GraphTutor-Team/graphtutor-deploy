.add-card {
  padding: 28rpx 32rpx 34rpx;
}

.form-group {
  margin-bottom: 22rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin-bottom: 12rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-text);
  background: linear-gradient(180deg, #ffffff 0%, #f3f6fb 100%);
  border-radius: 22rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.18);
  box-sizing: border-box;
}

.btn-save {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  margin-top: 14rpx;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-weight: 800;
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-cancel {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 48rpx;
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(21, 101, 192, 0.15);
  color: var(--color-primary);
  font-weight: 700;
}

.btn-cancel::after {
  border: none;
}