<view class="container">
  <view class="sub-header">
    <view class="sub-title">新增通讯录</view>
    <view class="sub-desc">先保存到本地，后续可对接社区/好友模块</view>
  </view>

  <view class="card add-card">
    <view class="form-group">
      <text class="form-label">姓名</text>
      <input class="form-input" value="{{name}}" placeholder="请输入姓名/昵称" bindinput="onNameInput" />
    </view>

    <view class="form-group">
      <text class="form-label">备注</text>
      <input class="form-input" value="{{remark}}" placeholder="例如：图谱伙伴、刷题好友..." bindinput="onRemarkInput" />
    </view>

    <view class="form-group">
      <text class="form-label">手机号</text>
      <input
        class="form-input"
        value="{{tel}}"
        placeholder="请输入手机号"
        type="tel"
        bindinput="onTelInput"
      />
    </view>

    <button class="btn-save" bindtap="onSave" loading="{{loading}}" disabled="{{loading}}">保存</button>

    <button class="btn-cancel" bindtap="goBack">返回</button>
  </view>
</view>
