.contacts-card {
  padding: 26rpx 28rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f3f6fb 100%);
  border: 1rpx solid rgba(21, 101, 192, 0.18);
  border-radius: 40rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.pill {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  background: rgba(21, 101, 192, 0.06);
  border: 1rpx solid rgba(21, 101, 192, 0.22);
  color: var(--color-primary);
  font-weight: 800;
  font-size: 26rpx;
  box-sizing: border-box;
}

.pill--add {
  padding-left: 18rpx;
  padding-right: 22rpx;
}

.pill--primary {
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border: none;
  color: #fff;
}

.dial-row {
  margin: -6rpx 0 18rpx;
  padding: 18rpx 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, rgba(21, 101, 192, 0.08), rgba(66, 165, 245, 0.06));
  border: 1rpx solid rgba(21, 101, 192, 0.12);
  display: flex;
  align-items: center;
  gap: 0;
}

.dial-row-text {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-primary);
}

.dial-row-hint {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.demo-row {
  margin: -6rpx 0 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 22rpx;
  background: rgba(21, 101, 192, 0.05);
  border: 1rpx solid rgba(21, 101, 192, 0.12);
  display: flex;
  align-items: center;
  gap: 0;
}

.demo-row-text {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--color-primary);
}

.demo-row-hint {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.empty {
  padding: 54rpx 0;
  text-align: center;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.contact-item {
  padding: 22rpx 20rpx 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 22rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.08);
  box-shadow: 0 10rpx 24rpx rgba(21, 101, 192, 0.06);
}

.contact-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-weight: 800;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
}

.name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.star {
  font-size: 34rpx;
  color: var(--color-primary);
  font-weight: 900;
  padding: 0 10rpx;
  line-height: 1;
}

.remark {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tel-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
}

.tel-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.tel-value {
  font-size: 26rpx;
  color: var(--color-text);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.contact-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  margin-top: 18rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(21, 101, 192, 0.08);
}

.action-btn {
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.action-btn--call {
  background: rgba(21, 101, 192, 0.06);
  border: 1rpx solid rgba(21, 101, 192, 0.32);
  color: var(--color-primary);
}

.action-btn--del {
  background: rgba(198, 40, 40, 0.06);
  border: 1rpx solid rgba(198, 40, 40, 0.32);
  color: var(--color-error);
}

.posts-section {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(21, 101, 192, 0.10);
}

.posts-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.posts-title {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--color-text);
}

.posts-hint {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.posts-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.post-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 18rpx;
  border-radius: 22rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.08);
  background: rgba(255, 255, 255, 0.92);
}

.post-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  color: #fff;
  font-weight: 900;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.post-body {
  min-width: 0;
  flex: 1;
}

.post-cover {
  width: 100%;
  height: 180rpx;
  border-radius: 14rpx;
  margin-bottom: 12rpx;
  background: #f2f6fc;
}

.post-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.post-author {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--color-text);
  white-space: nowrap;
}

.post-time {
  font-size: 22rpx;
  color: var(--color-text-muted);
}

.post-postTitle {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text);
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.post-content {
  display: block;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}