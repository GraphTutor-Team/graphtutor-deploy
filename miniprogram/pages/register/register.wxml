<view class="container container--auth">
  <view class="auth-hero">
    <view class="auth-logo">
      <text class="auth-logo-text">GT</text>
    </view>
    <view class="auth-title">注册 GraphTutor</view>
    <view class="auth-desc">使用邮箱创建账号，与 Web 端数据同步</view>
  </view>

  <view class="auth-card">
    <view class="form-error" wx:if="{{error}}">{{error}}</view>

    <view class="form-field">
      <text class="form-label">邮箱</text>
      <view class="input-box">
        <input
          class="form-input-inner"
          type="text"
          placeholder="your@email.com"
          value="{{email}}"
          bindinput="onEmailInput"
        />
      </view>
    </view>

    <view class="form-field">
      <text class="form-label">密码</text>
      <view class="input-box input-box--password">
        <input
          wx:if="{{showPassword}}"
          class="form-input-inner"
          type="text"
          placeholder="至少 6 位"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <input
          wx:else
          class="form-input-inner"
          password
          placeholder="至少 6 位"
          value="{{password}}"
          bindinput="onPasswordInput"
        />
        <view
          class="pwd-toggle"
          catchtap="togglePassword"
          hover-class="pwd-toggle--active"
        >{{passwordToggleText}}</view>
      </view>
    </view>

    <view class="form-field">
      <text class="form-label">确认密码</text>
      <view class="input-box">
        <input
          wx:if="{{showPassword}}"
          class="form-input-inner"
          type="text"
          placeholder="再次输入密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmInput"
        />
        <input
          wx:else
          class="form-input-inner"
          password
          placeholder="再次输入密码"
          value="{{confirmPassword}}"
          bindinput="onConfirmInput"
        />
      </view>
    </view>

    <view class="form-actions">
      <button
        class="btn btn--primary btn--block"
        loading="{{loading}}"
        disabled="{{loading}}"
        bindtap="submit"
      >注册</button>
    </view>

    <view class="auth-footer">
      <text>已有账号？</text>
      <text class="auth-link" bindtap="goLogin">去登录</text>
    </view>
  </view>
</view>
