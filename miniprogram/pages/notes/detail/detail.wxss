@import "../../../styles/feature-page.wxss";

.detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.detail-title {
  flex: 1;
  font-size: 34rpx;
}

.edit-link {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
}

.detail-meta {
  margin-bottom: 24rpx;
}

.note-body {
  font-size: 28rpx;
  line-height: 1.65;
  color: var(--color-text);
  white-space: pre-wrap;
}
