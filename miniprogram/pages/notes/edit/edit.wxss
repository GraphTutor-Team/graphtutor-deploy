@import "../../../styles/page-data.wxss";

.field {
  margin-bottom: 24rpx;
}

.field--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
}

.field--row .field-label {
  margin-bottom: 0;
}

.field-input {
  padding: 18rpx 20rpx;
  background: rgba(21, 101, 192, 0.04);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
}

.field-textarea {
  width: 100%;
  min-height: 280rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  background: rgba(21, 101, 192, 0.04);
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  line-height: 1.5;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, var(--color-primary-light), var(--color-primary));
  border: none;
}

.save-btn::after {
  border: none;
}
