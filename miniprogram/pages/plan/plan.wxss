.sub-header {
  padding: 24rpx 0 32rpx;
}

.sub-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.sub-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: 32rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  white-space: pre-line;
}

