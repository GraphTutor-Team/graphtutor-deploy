.page-banner {
  position: relative;
  height: 220rpx;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.page-banner-bg {
  width: 100%;
  height: 100%;
}

.page-banner-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(9, 42, 88, 0.74), rgba(31, 95, 170, 0.4));
}

.page-banner-content {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #fff;
}

.page-banner-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.page-banner-sub {
  font-size: 24rpx;
  opacity: 0.92;
}

.plan-meta {
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 700;
  margin-bottom: 8rpx;
  padding: 12rpx 18rpx;
  background: rgba(21, 101, 192, 0.06);
  border-radius: var(--radius-sm);
  display: inline-block;
}

.task-row {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 16rpx;
  margin: 0 -16rpx;
  border-radius: var(--radius-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.task-row:last-of-type {
  border-bottom: none;
}

.task-row:active {
  background: rgba(21, 101, 192, 0.04);
}

.task-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(21, 101, 192, 0.35);
  margin-right: 22rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  background: #fff;
}

.task-check--on {
  background: linear-gradient(145deg, var(--color-primary-light), var(--color-primary));
  border-color: transparent;
  box-shadow: 0 6rpx 16rpx rgba(21, 101, 192, 0.25);
}

.task-check-mark {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.task-title {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text);
  line-height: 1.5;
}

.task-title--done {
  color: var(--color-text-muted);
  text-decoration: line-through;
}

.btn-reset {
  margin-top: 28rpx;
  color: var(--color-primary);
  border-color: rgba(21, 101, 192, 0.35);
  background: rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
}

.streak {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: rgba(21, 101, 192, 0.08);
  font-weight: 700;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.week-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 0;
}

.week-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #d8e0f2;
}

.week-dot--on {
  background: var(--color-primary);
  box-shadow: 0 0 0 6rpx rgba(21, 101, 192, 0.12);
}

.week-day {
  font-size: 22rpx;
  color: var(--color-text-muted);
}
