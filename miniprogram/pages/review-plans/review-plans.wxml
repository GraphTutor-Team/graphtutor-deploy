<view class="container">
  <view class="feature-header">
    <view class="feature-title">复习计划</view>
    <view class="feature-desc">查看与执行复习计划（创建/编辑请在 Web 端）</view>
  </view>

  <view wx:if="{{!isLoggedIn}}" class="card">
    <view class="state-box">
      <view class="state-text">登录后查看复习计划</view>
      <button class="state-btn" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="state-text">加载中…</view>
  <view wx:elif="{{loadError}}" class="card">
    <view class="state-box">
      <view class="state-text">{{loadError}}</view>
      <button class="state-btn" bindtap="reload">重试</button>
    </view>
  </view>

  <block wx:else>
    <view class="card">
      <view wx:if="{{items.length === 0}}" class="state-text state-text--muted">暂无复习计划，请在 Web 端创建</view>
      <view class="item-card" wx:for="{{items}}" wx:key="id">
        <view class="item-row">
          <view class="item-title">{{item.name}}</view>
          <view class="item-action">{{item.statusText}}</view>
        </view>
        <view wx:if="{{item.description}}" class="item-meta">{{item.description}}</view>
        <view class="item-meta">{{item.typeText}} · {{item.strategyText}} · 每日 {{item.dailyCount}} 题</view>
        <button
          wx:if="{{item.canExecute}}"
          class="plan-btn"
          loading="{{executingId === item.id}}"
          disabled="{{!!executingId}}"
          data-id="{{item.id}}"
          bindtap="executePlan"
        >
          开始今日复习
        </button>
      </view>
    </view>
  </block>
</view>
