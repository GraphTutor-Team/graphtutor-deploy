# GraphTutor V3.0 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 服务器配置 ====================
NODE_ENV=development
PORT=5000

# ==================== 数据库配置 ====================
# MongoDB连接字符串
MONGODB_URI=mongodb://localhost:27017/graphtutor

# ==================== JWT认证配置 ====================
# JWT密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# ==================== 客户端配置 ====================
# 浏览器访问前端的根地址（CORS）。开发(Vite)示例: http://localhost:5173
# Docker 单端口部署须与 FRONTEND_URL 一致，例如: http://你的公网IP:5000
CLIENT_URL=http://localhost:5173

# OAuth 回调成功后重定向到此前端根地址（须与浏览器地址栏一致，含协议与端口）
FRONTEND_URL=http://localhost:5173

# API URL（前端使用）
API_URL=http://localhost:5000/api

# ==================== GitHub OAuth（网站登录）====================
# 在 https://github.com/settings/developers 创建 OAuth App：
# Authorization callback URL 填：
#   http://<你的域名或IP>:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==================== OpenAI配置（可选）====================
# 如果使用AI功能，请填写OpenAI API密钥
OPENAI_API_KEY=your-openai-api-key-here

# ==================== Redis配置（可选）====================
# 如果使用Redis缓存，请填写连接字符串
# REDIS_URL=redis://localhost:6379

# ==================== Swagger文档配置 ====================
# 是否启用Swagger API文档（生产环境建议关闭）
ENABLE_SWAGGER=true

