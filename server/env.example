# GraphTutor V3.0 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 服务器配置 ====================
NODE_ENV=development
PORT=5000

# ==================== 数据库配置 ====================
# MongoDB连接字符串
MONGODB_URI=mongodb://localhost:27017/graphtutor

# ==================== JWT认证配置 ====================
# JWT密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-secret-key-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-here

# ==================== 演示数据导入（可选）====================
# 一键导入（题库 + 好友/笔记/错题/计划/统计/通知等）：
#   SEED_TARGET_EMAIL=你的邮箱 npm run seed:user-demo --prefix server
# 或 npm run seed:all --prefix server
# SEED_TARGET_PASSWORD=  仅当该邮箱尚未注册时才需要（已有账号勿填）
# SEED_UPDATE_PROFILE=1  覆盖昵称/等级/积分（默认不改动已有账号）
# SEED_DEMO_PASSWORD=    演示好友统一密码（默认 DemoFriend2026!）
# SEED_SKIP_DEMO_CONTENT=1  跳过题库导入（已有题目时使用）
# SEED_PENDING_ONLY=1       好友仅发待处理请求
# SEED_SECTIONS=social,learning  只跑部分模块（见 seed-user-demo.js）

# 浏览器访问前端的根地址（CORS）。开发(Vite)示例: http://localhost:5173
# Docker 单端口部署须与 FRONTEND_URL 一致，例如: http://你的公网IP:5000
CLIENT_URL=http://localhost:5173

# OAuth 回调成功后重定向到此前端根地址（须与浏览器地址栏一致，含协议与端口）
FRONTEND_URL=http://localhost:5173

# API URL（前端使用）
API_URL=http://localhost:5000/api

# ==================== GitHub OAuth（网站登录）====================
# 在 https://github.com/settings/developers 创建 OAuth App：
# Authorization callback URL 填：
#   http://<你的域名或IP>:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ==================== 微信开放平台（可选，网站应用需企业主体；当前 Web 登录页未开放微信入口）====================
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# ==================== 微信小程序（wx.login 登录，与开放平台凭证不同）====================
# 在微信公众平台 → 开发 → 开发管理 → 开发设置 获取 AppID / AppSecret
# AppID 须与 miniprogram/project.config.json 中 appid 一致
# 修改后须重启后端（Docker: docker compose up -d --force-recreate server）
MINIPROGRAM_APP_ID=
MINIPROGRAM_APP_SECRET=

# ==================== Cookie / CSRF（HTTP 部署必读）====================
# 使用 http://公网IP:5000 访问时须为 false（或不设置，会根据 FRONTEND_URL 自动判断）
# 仅在使用 HTTPS 域名时设为 true
# COOKIE_SECURE=false

# ==================== OpenAI配置（可选）====================
# 如果使用AI功能，请填写OpenAI API密钥
OPENAI_API_KEY=your-openai-api-key-here

# ==================== Redis配置（可选）====================
# 如果使用Redis缓存，请填写连接字符串
# REDIS_URL=redis://localhost:6379

# ==================== Swagger文档配置 ====================
# 是否启用Swagger API文档（生产环境建议关闭）
ENABLE_SWAGGER=true

# ==================== API 限流（真机频繁测试时可调大或关闭）====================
# 15 分钟内同一 IP 超过上限会返回 429「API请求过于频繁」
# 演示/联调服务器可临时关闭或调大：
# RATE_LIMIT_DISABLED=true
# RATE_LIMIT_API_MAX=500
# RATE_LIMIT_STRICT_MAX=30
# RATE_LIMIT_WINDOW_MS=900000

# ==================== 编程题代码运行（可选）====================
# 服务器需安装 JDK；生产环境请谨慎开启
# ENABLE_CODE_RUN=true

