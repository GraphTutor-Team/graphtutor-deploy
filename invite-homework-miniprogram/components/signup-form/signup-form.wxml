<view class="form-wrap">
  <view class="form-item">
    <text class="label">姓名</text>
    <input class="input" placeholder="输入您的姓名" placeholder-class="input-placeholder" data-field="name" value="{{form.name}}" bindinput="onInputChange" />
  </view>

  <view class="form-item">
    <text class="label">学号</text>
    <input class="input" placeholder="输入您的学号" placeholder-class="input-placeholder" data-field="studentId" value="{{form.studentId}}" bindinput="onInputChange" />
  </view>

  <view class="form-item">
    <text class="label">手机号</text>
    <input class="input" type="number" maxlength="11" placeholder="输入 11 位手机号码" placeholder-class="input-placeholder" data-field="phone" value="{{form.phone}}" bindinput="onInputChange" />
  </view>

  <view class="form-item">
    <text class="label">报名身份</text>
    <radio-group class="inline-group" bindchange="onRoleChange">
      <label class="inline-item">
        <radio value="选手" checked="{{teamRole === '选手'}}" color="#3b82f6" />
        <text>选手</text>
      </label>
      <label class="inline-item">
        <radio value="志愿者" checked="{{teamRole === '志愿者'}}" color="#3b82f6" />
        <text>志愿者</text>
      </label>
    </radio-group>
  </view>

  <view class="form-item">
    <text class="label">技能方向（可多选）</text>
    <checkbox-group class="inline-group" bindchange="onSkillChange">
      <block wx:for="{{skillOptions}}" wx:key="value">
        <label class="inline-item skill-item">
          <checkbox value="{{item.value}}" checked="{{item.checked}}" color="#3b82f6" />
          <text>{{item.label}}</text>
        </label>
      </block>
    </checkbox-group>
  </view>

  <view class="form-item">
    <text class="label">备注（可选）</text>
    <textarea class="textarea" placeholder="其他说明" placeholder-class="input-placeholder" data-field="note" value="{{form.note}}" bindinput="onInputChange" />
  </view>

  <checkbox-group bindchange="onAgreeChange">
    <label class="agree-line">
      <checkbox value="agree" checked="{{agree}}" color="#3b82f6" />
      <text>我确认提交的信息真实有效</text>
    </label>
  </checkbox-group>

  <button class="submit-btn" type="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="handleSubmit">
    {{submitting ? '提交中...' : '提交报名'}}
  </button>
</view>
