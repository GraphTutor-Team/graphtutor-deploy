.form-wrap {
  padding-bottom: 16rpx;
}

.form-item {
  padding: 0 20rpx 14rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #1e3a8a;
  margin-bottom: 12rpx;
}

.input,
.textarea {
  width: 100%;
  background: #fff;
  border: 1rpx solid #bfdbfe;
  border-radius: 12rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 88rpx;
  height: 88rpx;
  color: #1f2937;
}

.input-placeholder {
  color: #94a3b8;
  font-size: 26rpx;
}

.textarea {
  height: 180rpx;
  padding-top: 18rpx;
  line-height: 1.6;
}

.agree-line {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 20rpx;
  font-size: 24rpx;
  color: #475569;
}

.submit-btn {
  margin: 0 20rpx;
  background: #2563eb !important;
  border-radius: 12rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
}

.inline-group {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.inline-item {
  margin-right: 20rpx;
  margin-bottom: 10rpx;
  color: #334155;
  font-size: 26rpx;
}

.skill-item {
  width: 100%;
  margin-right: 0;
}
