<view class="container">
  <view class="top-bar">
    <view class="top-bar-main">
      <text class="top-brand">{{brandName}}</text>
      <text class="top-tagline">{{brandTagline}} · {{brandVersion}}</text>
    </view>
    <text class="server-badge {{serverOnline ? 'online' : 'offline'}}">{{serverOnline ? '在线' : '离线'}}</text>
  </view>

  <view wx:if="{{activeTab === 'invite'}}" class="section invite-card">
    <image class="cover" mode="aspectFit" src="{{coverImage}}" lazy-load="true" />
    <view class="invite-content">
      <text class="en-title">{{inviteTitle}}</text>
      <text class="cn-title">{{subTitle}}</text>
      <text class="slogan">{{inviteSlogan}}</text>
      <text class="couple">{{organizer}}</text>
      <text class="meta">{{inviteDesc}}</text>
      <text class="meta">时间：{{inviteDate}}</text>
      <text class="meta">地点：{{invitePlace}}</text>
      <text class="meta">报名截止：{{registerDeadline}}</text>
    </view>

    <view class="path-wrap">
      <section-header title="推荐学习路径" subtitle="与 GraphTutor 首页一致的三步入门" />
      <view class="path-list">
        <block wx:for="{{learningPath}}" wx:key="step">
          <view class="path-item">
            <view class="path-step">{{item.step}}</view>
            <view class="path-body">
              <text class="path-title">{{item.title}}</text>
              <text class="path-desc">{{item.desc}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="highlights-wrap">
      <section-header title="活动亮点" subtitle="{{brandDesc}}" />
      <view class="highlights-list">
        <block wx:for="{{highlights}}" wx:key="title">
          <view class="highlight-item">
            <text class="highlight-icon">{{item.icon}}</text>
            <view class="highlight-body">
              <text class="highlight-title">{{item.title}}</text>
              <text class="highlight-desc">{{item.desc}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="map-wrap">
      <section-header title="{{sections.mapTitle}}" subtitle="{{sections.mapSubtitle}}" />
      <map
        class="event-map"
        latitude="{{mapLat}}"
        longitude="{{mapLng}}"
        scale="16"
        markers="{{mapMarkers}}"
        show-location
      />
      <button class="map-btn" bindtap="openEventLocation">打开地图导航</button>
    </view>
  </view>

  <view wx:if="{{activeTab === 'photos'}}" class="section">
    <section-header title="{{sections.photosTitle}}" subtitle="{{sections.photosSubtitle}}" />
    <scroll-view class="photo-scroll" scroll-y="true">
      <view class="photo-list">
        <block wx:for="{{photoList}}" wx:key="title">
          <view class="photo-card">
            <image
              class="photo-vertical"
              mode="aspectFit"
              src="{{item.image}}"
              lazy-load="true"
              data-index="{{index}}"
              data-list="photo"
              bindtap="previewPhoto"
            />
            <view class="photo-caption">{{item.title}}</view>
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{activeTab === 'history'}}" class="section">
    <section-header title="{{sections.historyTitle}}" subtitle="{{sections.historySubtitle}}" />
    <view class="history-switch">
      <view class="switch-item {{historyMode === 'gallery' ? 'on' : ''}}" data-mode="gallery" bindtap="switchHistoryMode">图集</view>
      <view class="switch-item {{historyMode === 'video' ? 'on' : ''}}" data-mode="video" bindtap="switchHistoryMode">视频</view>
    </view>

    <view wx:if="{{historyMode === 'gallery'}}" class="swiper-wrap">
      <swiper
        class="history-swiper"
        indicator-dots="true"
        indicator-color="rgba(30,58,138,0.25)"
        indicator-active-color="#2563eb"
        autoplay="true"
        interval="4000"
        circular="true"
        bindchange="onHistorySwiperChange"
      >
        <block wx:for="{{historyList}}" wx:key="title">
          <swiper-item>
            <view class="swiper-slide">
              <image
                class="swiper-image"
                mode="aspectFit"
                src="{{item.image}}"
                lazy-load="true"
                data-index="{{index}}"
                data-list="history"
                bindtap="previewPhoto"
              />
              <view class="swiper-caption">{{item.title}}</view>
            </view>
          </swiper-item>
        </block>
      </swiper>
      <view class="swiper-indicator-text">{{historySwiperIndex + 1}} / {{historyList.length}}</view>
    </view>

    <view wx:if="{{historyMode === 'video'}}">
      <view class="section-subtitle">赛事回顾视频</view>
      <view class="video-note">{{brandDesc}}。视频由服务器 {{serverBase}} 提供，项目内 assets/videos/ 为备份文件。</view>
      <view class="video-switch">
        <block wx:for="{{videoList}}" wx:key="id">
          <view class="video-switch-item {{currentVideoIndex === item.id ? 'on' : ''}}" data-idx="{{item.id}}" bindtap="changeVideo">{{item.label}}</view>
        </block>
      </view>
      <view class="video-wrap">
        <button wx:if="{{!showVideo && !videoError}}" class="video-load-btn" bindtap="loadVideo">点击加载视频</button>
        <video
          wx:if="{{showVideo && !videoError}}"
          class="promo-video"
          src="{{promoVideo}}"
          controls
          objectFit="cover"
          initial-time="0"
          enable-play-gesture
          binderror="onVideoError"
        />
        <view wx:if="{{videoError}}" class="video-fallback">
          <image class="video-fallback-img" src="/assets/images/theme-12.jpg" mode="aspectFill" />
          <text class="video-fallback-text">视频加载失败。请确认服务器已启动且 htdocs 中存在 1.mp4 / 2.mp4。</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'guest'}}" class="section form-section">
    <section-header title="{{sections.formTitle}}" subtitle="{{sections.formSubtitle}}" />
    <view wx:if="{{serverOnline}}" class="register-stat">当前已有 {{registerCount}} 人报名</view>
    <signup-form id="signupForm" submitting="{{submitting}}" bind:submit="onFormSubmit" />
  </view>

  <view class="bottom-nav">
    <view class="nav-item {{activeTab === 'invite' ? 'active' : ''}}" data-tab="invite" bindtap="switchTab">
      <image class="nav-icon-img" src="{{activeTab === 'invite' ? '/assets/icons/tab-invite-active.svg' : '/assets/icons/tab-invite.svg'}}" />
      <text class="nav-text">赛事邀请</text>
    </view>
    <view class="nav-item {{activeTab === 'photos' ? 'active' : ''}}" data-tab="photos" bindtap="switchTab">
      <image class="nav-icon-img" src="{{activeTab === 'photos' ? '/assets/icons/tab-photo-active.svg' : '/assets/icons/tab-photo.svg'}}" />
      <text class="nav-text">照片</text>
    </view>
    <view class="nav-item {{activeTab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="switchTab">
      <image class="nav-icon-img" src="{{activeTab === 'history' ? '/assets/icons/tab-history-active.svg' : '/assets/icons/tab-history.svg'}}" />
      <text class="nav-text">往期举办</text>
    </view>
    <view class="nav-item {{activeTab === 'guest' ? 'active' : ''}}" data-tab="guest" bindtap="switchTab">
      <image class="nav-icon-img" src="{{activeTab === 'guest' ? '/assets/icons/tab-form-active.svg' : '/assets/icons/tab-form.svg'}}" />
      <text class="nav-text">报名信息</text>
    </view>
  </view>
</view>
