.container {
  min-height: 100vh;
  padding: 0 20rpx 132rpx;
  box-sizing: border-box;
  background: #eef4ff;
}

.section {
  margin-top: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(30, 64, 175, 0.08);
}

.top-bar {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  color: #fff;
  background: linear-gradient(120deg, #2563eb, #1d4ed8);
  border-bottom-left-radius: 16rpx;
  border-bottom-right-radius: 16rpx;
  padding: 0 120rpx 0 24rpx;
  box-sizing: border-box;
}

.top-bar-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  line-height: 1.2;
}

.top-brand {
  font-size: 30rpx;
  font-weight: 700;
}

.top-tagline {
  font-size: 20rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.server-badge {
  position: absolute;
  right: 16rpx;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.server-badge.online {
  background: rgba(34, 197, 94, 0.25);
  color: #dcfce7;
}

.server-badge.offline {
  background: rgba(248, 113, 113, 0.25);
  color: #fee2e2;
}

.map-wrap {
  padding: 0 12rpx 20rpx;
}

.path-wrap,
.highlights-wrap {
  padding: 0 12rpx 8rpx;
}

.path-list {
  padding: 0 12rpx 16rpx;
}

.path-item {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 16rpx;
  margin-bottom: 10rpx;
  background: #fff;
  border: 1rpx solid #dbeafe;
  border-radius: 12rpx;
}

.path-item:last-child {
  margin-bottom: 0;
}

.path-step {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #2563eb;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.path-body {
  flex: 1;
}

.path-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e3a8a;
}

.path-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #64748b;
}

.highlights-list {
  padding: 0 12rpx 16rpx;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  margin-bottom: 12rpx;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  border-radius: 14rpx;
}

.highlight-item:last-child {
  margin-bottom: 0;
}

.highlight-icon {
  font-size: 36rpx;
  line-height: 1;
  margin-right: 16rpx;
}

.highlight-body {
  flex: 1;
}

.highlight-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e3a8a;
  margin-bottom: 6rpx;
}

.highlight-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.5;
  color: #475569;
}

.event-map {
  width: calc(100% - 24rpx);
  height: 320rpx;
  margin: 0 12rpx;
  border-radius: 14rpx;
}

.map-btn {
  margin: 12rpx 12rpx 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #1d4ed8;
  background: #e8f0ff;
  border: 1rpx solid #bfd6ff;
  border-radius: 12rpx;
}

.swiper-wrap {
  padding: 0 20rpx 20rpx;
}

.history-swiper {
  height: 620rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.swiper-slide {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f3f7ff;
  border-radius: 18rpx;
  overflow: hidden;
}

.swiper-image {
  width: 100%;
  height: 540rpx;
  display: block;
}

.swiper-caption {
  padding: 16rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e3a8a;
}

.swiper-indicator-text {
  text-align: center;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
}

.register-stat {
  margin: 0 24rpx 12rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #1d4ed8;
  background: #e8f0ff;
  border-radius: 10rpx;
  border: 1rpx solid #bfdbfe;
}

.photo-scroll {
  max-height: 980rpx;
}

.invite-card {
  padding: 24rpx;
}

.cover {
  width: 100%;
  height: 720rpx;
  border-radius: 18rpx;
  background: #eaf1ff;
}

.invite-content {
  text-align: center;
  padding: 24rpx 12rpx 16rpx;
}

.en-title {
  display: block;
  font-size: 36rpx;
  color: #1d4ed8;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.cn-title {
  display: block;
  font-size: 34rpx;
  color: #2563eb;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.slogan {
  display: block;
  font-size: 24rpx;
  color: #7c3aed;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.couple {
  display: block;
  font-size: 26rpx;
  color: #334155;
  margin-bottom: 14rpx;
}

.meta {
  display: block;
  font-size: 24rpx;
  line-height: 1.8;
  color: #475569;
}

.photo-list {
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.photo-vertical {
  width: 100%;
  height: 560rpx;
  border-radius: 18rpx;
  display: block;
  margin-bottom: 18rpx;
  background: #f3f7ff;
}

.photo-vertical:last-child {
  margin-bottom: 0;
}

.photo-card {
  margin-bottom: 18rpx;
}

.photo-card:last-child {
  margin-bottom: 0;
}

.photo-caption {
  padding: 10rpx 6rpx 2rpx;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 600;
}

.history-mask {
  padding: 10rpx 6rpx 2rpx;
  color: #1e3a8a;
  font-size: 24rpx;
  font-weight: 600;
}

.history-card {
  margin-bottom: 16rpx;
}

.history-card:last-child {
  margin-bottom: 0;
}

.history-switch {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 18rpx;
}

.switch-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  border: 1rpx solid #dbeafe;
  border-radius: 12rpx;
  background: #f8fbff;
}

.switch-item.on {
  color: #1d4ed8;
  border-color: #93c5fd;
  background: #e8f0ff;
  font-weight: 600;
}

.section-subtitle {
  padding: 0 24rpx 14rpx;
  color: #1e3a8a;
  font-size: 28rpx;
  font-weight: 600;
}

.video-note {
  margin: 0 24rpx 12rpx;
  padding: 12rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #475569;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  border-radius: 10rpx;
}

.video-wrap {
  padding: 0 20rpx 20rpx;
}

.video-switch {
  padding: 0 20rpx 12rpx;
  display: flex;
  gap: 12rpx;
}

.video-switch-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  border-radius: 10rpx;
}

.video-switch-item.on {
  color: #1d4ed8;
  font-weight: 600;
  background: #e8f0ff;
  border-color: #93c5fd;
}

.video-load-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #1d4ed8;
  background: #e8f0ff;
  border: 1rpx solid #bfd6ff;
  border-radius: 14rpx;
}

.promo-video {
  width: 100%;
  height: 360rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #0f172a;
}

.video-fallback {
  background: #f8fbff;
  border: 1rpx solid #dbeafe;
  border-radius: 14rpx;
  padding: 12rpx;
}

.video-fallback-img {
  width: 100%;
  height: 280rpx;
  border-radius: 10rpx;
  display: block;
}

.video-fallback-text {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 22rpx;
  line-height: 1.6;
}

.form-section {
  padding-bottom: 8rpx;
}

.bottom-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  background: #fff;
  border-top: 1rpx solid #dbeafe;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #b4b4b4;
}

.nav-icon {
  font-size: 30rpx;
  line-height: 1.1;
}

.nav-icon-img {
  width: 40rpx;
  height: 40rpx;
  display: block;
}

.nav-text {
  font-size: 22rpx;
  margin-top: 4rpx;
}

.nav-item.active {
  color: #2563eb;
}
