.index-hero {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 28rpx;
  padding: 28rpx 24rpx 26rpx;
  box-shadow: 0 14rpx 36rpx rgba(21, 101, 192, 0.14);
}

.index-hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.index-hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, rgba(9, 42, 88, 0.74), rgba(31, 95, 170, 0.4));
}

.index-hero-badge {
  position: relative;
  display: inline-block;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #1565c0;
  background: rgba(255, 255, 255, 0.75);
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(21, 101, 192, 0.12);
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(21, 101, 192, 0.06);
}

.index-hero-title {
  position: relative;
  font-size: 48rpx;
  font-weight: 800;
  color: #ffffff;
  line-height: 1.2;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.index-hero-desc {
  position: relative;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.45;
}
